# ── Unity generated / machine-specific (patterns are non-anchored so they
#    match inside the "Ori Ascendant/" project subfolder) ──
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Uu]serSettings/
[Cc]rashlytics/

# Generated IDE/solution files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db

# IDE / editor / OS
.vs/
.vscode/
.idea/
.DS_Store
*.tmp
*.stackdump
sysinfo.txt

# Plastic SCM workspace metadata (this repo uses git)
.plastic/

# Build outputs
*.apk
*.aab
*.ipa
*.app
*.unitypackage.meta.bak

# Apple signing material — never commit secrets if added later
*.p12
*.mobileprovision
*.cer

# Agent-skill installs (local tooling, e.g. `npx skills add`) — the skills
# live in .agents/skills/ and are symlinked into .claude/skills/ for Claude
# Code. Local-only wiring; do not commit (symlinks would dangle on clone).
.agents/
**/.claude/skills/
